# Template for test/e2e/.env.e2e — copy, fill in, never commit the copy.
# `.gitignore` ignores every .env* except *.example / *.sample / *.template,
# so this file is safe to track and your filled-in copy cannot be added.
#
# The suite validates all of this up front: a missing required variable throws
# before any test runs, rather than skipping quietly. See test/e2e/README.md.

# --- Required -------------------------------------------------------------
# Gateway base URL for the target environment, e.g. https://api.predev5....
TDP_ENDPOINT=
# The org the suite emits as and asserts against.
TDP_ORG_SLUG=
# Where the collector writes customer product events,
# e.g. /tdp/ts-predev5/customer-events
CUSTOMER_EVENTS_LOG_GROUP=

# --- Auth: set exactly ONE of these ---------------------------------------
# Setting both is rejected on purpose — "which credential did that run use?"
# should not be answerable only from memory.
#
# A token you already hold (simplest for a local run):
TDP_AUTH_TOKEN=
# ...or the SSM path holding the admin password to log in with. This is the
# default path in CI, where the tdp-e2e CodeBuild role already grants
# ssm:GetParameter on it.
# ADMIN_PASSWORD_SSM_PARAM=

# --- Optional (defaults shown) --------------------------------------------
# AWS_REGION=us-east-2
# CF_ENVIRONMENT=development
# CUSTOMER_METRIC_NAMESPACE=TDP/CustomerMetrics
#
# Artifact identity this suite reports as. `type` is not settable here — the
# bindings supply "data-app" themselves (see resolveArtifact), because the
# distro requires a kind and refuses to guess one.
# E2E_ARTIFACT_NAMESPACE=common
# E2E_ARTIFACT_SLUG=ts-lib-ui-kit-e2e
# E2E_ARTIFACT_VERSION=0.0.0
