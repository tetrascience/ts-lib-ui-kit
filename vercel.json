{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "yarn build-storybook",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!*.md'",
  "outputDirectory": "storybook-static",
  "framework": null,
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 30,
      "includeFiles": "storybook-static/mcp/components.json"
    }
  }
}
